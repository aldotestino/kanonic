{
  "name": "@okfetch/fetch",
  "version": "0.6.0",
  "description": "A type-safe fetch wrapper with validation, retries, plugins, and streaming.",
  "keywords": [
    "fetch",
    "http",
    "standard-schema",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/aldotestino/okfetch#readme",
  "bugs": {
    "url": "https://github.com/aldotestino/okfetch/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldotestino/okfetch.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "better-result": "^3.0.1",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "better-result": "^3.0.1"
  }
}
